# Optional for local demo mode. For live use, fill these from the owner-managed Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets for Paystack checkout, callback verification, and webhook reconciliation.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public business WhatsApp number in international format, digits only (for example 2348012345678).
NEXT_PUBLIC_WHATSAPP_NUMBER=
